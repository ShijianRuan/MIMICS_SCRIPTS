{
  "poll_seconds": 0.25,
  "job_retention_days": 3,
  "job_max_terminal": 20,
  "itk_snake": {
    "default_profile": "balanced",
    "timeout_seconds": 1800,
    "gradient_sigma_mm": 1.0,
    "profiles": {
      "conservative": {
        "maximum_displacement_mm": 2.0,
        "maximum_iterations": 50,
        "propagation_scaling": 0.35,
        "curvature_scaling": 1.0,
        "advection_scaling": 1.0,
        "maximum_volume_change_ratio": 0.8
      },
      "balanced": {
        "maximum_displacement_mm": 5.0,
        "maximum_iterations": 80,
        "propagation_scaling": 0.7,
        "curvature_scaling": 0.8,
        "advection_scaling": 1.0,
        "maximum_volume_change_ratio": 1.5
      },
      "aggressive": {
        "maximum_displacement_mm": 10.0,
        "maximum_iterations": 120,
        "propagation_scaling": 1.1,
        "curvature_scaling": 0.55,
        "advection_scaling": 1.0,
        "maximum_volume_change_ratio": 4.0
      }
    }
  },
  "igac": {
    "timeout_seconds": 28800,
    "device": "auto",
    "allow_cpu_fallback": true,
    "gpu_lock_timeout_seconds": 300,
    "workspace_margin_mm": 40.0,
    "max_roi_voxels": 10000000,
    "max_cpu_roi_voxels": 1500000,
    "display_interval_seconds": 0.12,
    "iterations_per_cycle": 1,
    "auto_run": true,
    "parameters": {
      "range_mm": 3.0,
      "smooth": 50.0,
      "grow": 0.0,
      "max_displacement_mm": 10.0,
      "data_weight": 30.0,
      "regularization": 1.0,
      "time_step": 0.1,
      "variance_floor": 0.0001,
      "phi_limit": 20.0,
      "gaussian_radius_limit": 24
    }
  },
  "scribbleprompt": {
    "timeout_seconds": 900,
    "device": "cpu",
    "input_size": 128,
    "prior_logit_magnitude": 6.0,
    "checkpoint": "external/ScribblePrompt/checkpoints/ScribblePrompt_unet_v1_nf192_res128.pt"
  }
}
